# Only a hostname, without https:// or a path.
DOMAIN=relay.example.com
ACME_EMAIL=you@example.com
AUTH_USERNAME=relay
AUTH_PASSWORD_PATH=./secrets/auth_password

# Cache body + metadata reservations, in bytes. Default: 20 GiB.
CACHE_MAX_BYTES=21474836480
CACHE_OBJECT_MAX_BYTES=4294967296
CACHE_TTL=24h
MAX_CONCURRENT=8
REQUESTS_PER_SECOND=10
REQUEST_BURST=20
GIT_REQUEST_MAX_BYTES=33554432
