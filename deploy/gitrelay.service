[Unit]
Description=Read-only GitHub Git Smart HTTP relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/gitrelay
EnvironmentFile=-/etc/gitrelay/gitrelay.env
Environment=GOMEMLIMIT=128MiB
Environment=GOMAXPROCS=2
Restart=on-failure
RestartSec=3s
TimeoutStopSec=35s

DynamicUser=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
LockPersonality=yes
MemoryDenyWriteExecute=yes

MemoryHigh=128M
MemoryMax=192M
CPUQuota=100%
Nice=5
TasksMax=64
LimitNOFILE=1024
LogRateLimitIntervalSec=30s
LogRateLimitBurst=200

[Install]
WantedBy=multi-user.target
